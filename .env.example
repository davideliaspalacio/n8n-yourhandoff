# --- Servicio ---------------------------------------------------------------
# Clave que deben mandar los clientes en la cabecera X-API-Key.
# Sin ella el servicio rechaza todas las peticiones a /v1. openssl rand -hex 32
API_KEY=
# Postgres para flow_runs y cost_events (se migra sola al arrancar).
# Vacío = runs en memoria, se pierden al reiniciar.
DATABASE_URL=
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY=1

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# USD por millón de tokens -- verificar en platform.openai.com/pricing
PRICE_INPUT_PER_M=2.00
PRICE_CACHED_INPUT_PER_M=0.50
PRICE_OUTPUT_PER_M=8.00

# --- Supabase de Alma (credencial "Alma Supabase" de n8n) -------------------
# Tablas handoff_prompt_library y accounts. Usar la service_role key.
ALMA_SUPABASE_URL=
ALMA_SUPABASE_KEY=
TEAM_NAMES=Operations,Sales,Executive,Technology,Talent
INTERNAL_EMAIL_DOMAIN=yourhandoff.com

# --- Edge function handle-discovery-call-booked ------------------------------
# URL completa de la función y la cabecera de la credencial
# "Supabase Handoff Portal" de n8n (nombre y valor).
EVENT_FUNCTION_URL=
EVENT_FUNCTION_AUTH_HEADER=Authorization
EVENT_FUNCTION_AUTH_VALUE=

# --- Unipile (credencial "Unipile Header Auth") ------------------------------
# DSN de la cuenta, p. ej. https://apiN.unipile.com:PORT
UNIPILE_BASE_URL=
UNIPILE_API_KEY=
UNIPILE_EMAILS_PER_ACCOUNT=5

# --- Fireflies ---------------------------------------------------------------
# Opcional: sin clave, el resumen de comunicaciones sale solo de los correos.
FIREFLIES_API_KEY=
FIREFLIES_TRANSCRIPTS_PER_EMAIL=3

# --- Apollo (credencial "Agent Apollo Auth") ---------------------------------
APOLLO_API_KEY=
# USD por crédito -- verificar contra el plan de Apollo
PRICE_APOLLO_PER_CREDIT=0

# --- SerpApi (noticias y empleos) --------------------------------------------
# Opcional: sin clave, el resumen de empresa se hace sin noticias ni empleos.
SERPAPI_API_KEY=
PRICE_SERPAPI_PER_SEARCH=0

# --- HubSpot (credencial "David HubSpot", private app token) -----------------
# Scopes: crm.objects.companies.read/write, crm.objects.contacts.read/write
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_CONTACT_LINKEDIN_PROPERTY=hs_linkedin_url

# --- Slack de Handoff --------------------------------------------------------
# Bot token con chat:write, invitado al canal #discovery-call-booked.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
